{
  "name": "HQDay",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "employee": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "revision": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "closed_by": {
      "type": "string"
    },
    "closed_by_email": {
      "type": "string"
    },
    "reopen_count": {
      "type": "number"
    },
    "last_reopen_reason": {
      "type": "string"
    },
    "last_reopened_by": {
      "type": "string"
    },
    "rule_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshot": {
      "type": "object"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}