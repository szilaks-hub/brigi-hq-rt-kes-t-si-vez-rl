{
  "name": "HQTask",
  "type": "object",
  "properties": {
    "employee": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "due_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done"
      ],
      "default": "open"
    },
    "outcome": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "closed_date": {
      "type": "string"
    },
    "postpone_count": {
      "type": "number"
    },
    "reminder_count": {
      "type": "number"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "megkereses",
        "ajanlat_utani",
        "dokumentumkeres",
        "arfrissites",
        "latogatas",
        "muszaki_egyeztetes",
        "rendeles_ellenorzes",
        "visszaaktivitas",
        "szallitas",
        "reklamacio",
        "egyeb"
      ],
      "default": "megkereses"
    },
    "priority": {
      "type": "string",
      "enum": [
        "magas",
        "kozepes",
        "alacsony"
      ],
      "default": "kozepes"
    },
    "next_step": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "suspended": {
      "type": "boolean"
    },
    "suspended_reason": {
      "type": "string"
    },
    "postpone_reason": {
      "type": "string"
    },
    "previous_due": {
      "type": "string"
    },
    "archived": {
      "type": "boolean"
    }
  },
  "required": [
    "employee",
    "company_id",
    "note",
    "due_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}