        "sales",
        "purchase"
      ]
    },
    "company_key": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "kg": {
      "type": "number"
    },
    "net": {
      "type": "number"
    },
    "rows": {
      "type": "number"
    },
    "first_date": {
      "type": "string"
    },
    "last_date": {
      "type": "string"
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status_mix": {
      "type": "object"
    },
    "currency": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
